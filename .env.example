# Persistência server-side. Nunca use prefixos REACT_APP_ ou VITE_ nestas
# credenciais: tudo que recebe esses prefixos pode ser exposto no navegador.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
COMPANY_ID=arcd
SUPABASE_BUCKET=arcd-ponto

# Motor financeiro. Migrations e carga em sombra são executadas manualmente
# por `npm run financial:migrate-shadow`, nunca pelo build do frontend.
POSTGRES_URL_NON_POOLING=postgresql://USUARIO:SENHA@HOST:5432/postgres
FINANCIAL_ENGINE_ENFORCE=false

# Operação e recuperação
BACKUP_ENCRYPTION_KEY=CHAVE_ALEATORIA_DE_32_BYTES
CRON_SECRET=SEGREDO_DO_CRON
SETUP_SECRET=SEGREDO_DO_PRIMEIRO_ACESSO

# Microsoft Graph / OneDrive (somente no backend; nunca use REACT_APP_)
MICROSOFT_CLIENT_ID=ID_DO_APLICATIVO
MICROSOFT_CLIENT_SECRET=SEGREDO_DO_CLIENTE
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://pontosarcd.vercel.app/api/microsoft/callback
ONEDRIVE_ROOT_FOLDER_URL=LINK_DA_PASTA_PRINCIPAL

# Vídeo público e otimizado do fundo do login. Use URL HTTPS de um arquivo
# WebM ou MP4, nunca um link de página de compartilhamento. Este valor é
# público no bundle e não deve conter credenciais.
VITE_LOGIN_BACKGROUND_VIDEO_URL=https://cdn.exemplo.com/arcd-login.webm

# Gemini (contingência server-side). O administrador também pode cadastrar a
# chave criptografada diretamente em Configurações dentro do ArcD.
GEMINI_API_KEY=CHAVE_DA_API_GEMINI
GEMINI_MODEL=gemini-3.6-flash
AI_ENCRYPTION_KEY=CHAVE_ALEATORIA_INDEPENDENTE_DA_SERVICE_ROLE
