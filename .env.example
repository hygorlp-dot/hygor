# Copie este arquivo para .env e preencha com seus valores do Supabase
REACT_APP_SUPABASE_URL=https://SEU_PROJETO.supabase.co
REACT_APP_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# Microsoft Graph / OneDrive (somente no backend; nunca use REACT_APP_)
MICROSOFT_CLIENT_ID=ID_DO_APLICATIVO
MICROSOFT_CLIENT_SECRET=SEGREDO_DO_CLIENTE
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://pontosarcd.vercel.app/api/microsoft/callback
ONEDRIVE_ROOT_FOLDER_URL=LINK_DA_PASTA_PRINCIPAL

# Vídeo público e otimizado do fundo do login. Use URL HTTPS de um arquivo
# WebM ou MP4, nunca um link de página de compartilhamento. Este valor é
# público no bundle e não deve conter credenciais.
VITE_LOGIN_BACKGROUND_VIDEO_URL=https://cdn.exemplo.com/arcd-login.webm

# Gemini (contingência server-side). O administrador também pode cadastrar a
# chave criptografada diretamente em Configurações dentro do ArcD.
GEMINI_API_KEY=CHAVE_DA_API_GEMINI
GEMINI_MODEL=gemini-3.6-flash
