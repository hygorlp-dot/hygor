#!/bin/sh
# Barra o push quando a verificação falha. O deploy da Vercel sai de cada push
# no main, antes do CI terminar - então esta é a última porta antes da
# produção. Validação local inclui lint, arquitetura, tipos e build sem
# prebuild de banco. As migrations pertencem ao corte aprovado, não ao push.
#
# Emergência (sabendo o que está fazendo): git push --no-verify
set -e
echo "pre-push: verificando antes de publicar (lint, arquitetura, tipos, build local e testes)..."
npm run --silent validate:local
npx vitest run --reporter=dot
echo "pre-push: tudo verde."
