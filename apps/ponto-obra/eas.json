{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "producao": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "PONTO_AMBIENTE": "producao"
      }
    },
    "homologacao": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "PONTO_AMBIENTE": "homologacao"
      }
    }
  },
  "submit": {
    "producao": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
