{
  "name": "arcd-ponto-pro",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.19",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^3.6.0"
  },
  "scripts": {
    "prebuild": "node scripts/check-financial-enforcement-readiness.mjs && node scripts/audit-catalog-integrity.mjs && npm run financial:migrate-shadow && npm run registry:migrate-shadow && npm run equipment-registry:migrate-shadow && npm run purchase-requests:migrate && npm run financial-engine:rls && npm run procurement-registry:migrate-shadow && npm run attendance-registry:migrate-shadow",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "lint": "node scripts/check-financial-boundaries.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.quality.json",
    "quality:bundle": "node scripts/bundle-metrics.mjs",
    "financial:migrate-shadow": "node scripts/apply-financial-shadow.mjs",
    "registry:migrate-shadow": "node scripts/apply-core-registry-shadow.mjs",
    "equipment-registry:migrate-shadow": "node scripts/apply-equipment-registry-shadow.mjs",
    "procurement-registry:migrate-shadow": "node scripts/apply-procurement-shadow.mjs",
    "attendance-registry:migrate-shadow": "node scripts/apply-attendance-registry-shadow.mjs",
    "purchase-requests:migrate": "node scripts/apply-purchase-requests-live.mjs",
    "financial-engine:rls": "node scripts/apply-financial-engine-rls.mjs",
    "split-rows:seed": "node scripts/seed-split-domain-rows.mjs",
    "attendance-obra-rows:seed": "node scripts/seed-attendance-obra-rows.mjs",
    "registry:shadow-status": "node scripts/check-core-registry-shadow-status.mjs",
    "conciliacao:backfill-contraparte-pix": "node scripts/backfill-conciliacao-contraparte-pix.mjs",
    "equipment-registry:shadow-status": "node scripts/check-equipment-registry-shadow-status.mjs",
    "procurement-registry:shadow-status": "node scripts/check-procurement-registry-shadow-status.mjs",
    "attendance-registry:shadow-status": "node scripts/check-attendance-registry-shadow-status.mjs",
    "attendance:check-synced-at-gaps": "node scripts/check-attendance-synced-at-gaps.mjs",
    "assets:login": "node scripts/optimize-login-assets.mjs",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs src api server",
    "quality:knip": "knip --config knip.json --no-exit-code --reporter compact --no-progress --include files,dependencies,exports",
    "pwa:generate": "node scripts/generate-shell-service-worker.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@playwright/test": "^1.62.0",
    "@storybook/react-vite": "^10.5.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "dependency-cruiser": "^18.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3",
    "storybook": "^10.5.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "uuid": "^11.1.1"
  }
}
